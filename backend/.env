# ==========================
# Application
# ==========================

ENVIRONMENT=development
DEBUG=true

# ==========================
# MongoDB
# ==========================

MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=ai_content_assistant

# ==========================
# JWT Authentication
# ==========================

JWT_SECRET=generate_a_random_64_character_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================
# AI Provider
# ==========================

AI_PROVIDER=groq

# Replace with your NEW Gemini API key
# (Generate a new one because the previous one was exposed.)
AI_API_KEY=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

AI_MODEL=llama-3.3-70b-versatile

# Optional (not used for Gemini)
AI_BASE_URL=https://api.openai.com/v1

# ==========================
# CORS
# ==========================

CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500